<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hello.demo.mybatis.mapper.UserMapper">
    <cache/>
    <select id="getUserById" resultType="com.hello.demo.mybatis.pojo.User" parameterType="java.math.BigInteger">
        select * from user where id = #{id}
    </select>

    <select id="getUser" resultType="com.hello.demo.mybatis.pojo.User">
        select * from user where id = #{param1} and email = #{param2}
    </select>

    <select id="getUsers" resultType="com.hello.demo.mybatis.pojo.User">
        select * from user
    </select>
</mapper>